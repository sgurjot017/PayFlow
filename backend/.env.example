PAYFLOW_ENV=local
PAYFLOW_AUTH_MODE=local
PAYFLOW_DEV_BEARER_TOKEN=replace-with-at-least-32-random-characters
PAYFLOW_DATABASE_URL=jdbc:postgresql://localhost:5432/payflow
PAYFLOW_DATABASE_USER=payflow
PAYFLOW_DATABASE_PASSWORD=local-development-only
PAYFLOW_HOST=0.0.0.0
PAYFLOW_PORT=8080

# Use your rotated test secret locally. Never put this in Android Gradle properties.
STRIPE_SECRET_KEY=
# Create with `stripe listen --forward-to localhost:8080/v1/webhooks/stripe`.
STRIPE_WEBHOOK_SECRET=
